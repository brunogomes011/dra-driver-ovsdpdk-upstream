# OVS/OVS-DPDK test image based on Fedora latest.
# Used by the e2e test suite to provide a real OVSDB + ovs-vswitchd
# (in DPDK mode with --no-pci --no-huge) inside the Kind cluster.
FROM fedora:latest

RUN dnf install -y \
        openvswitch \
        openvswitch-dpdk \
    && dnf clean all

# Ensure runtime directories exist in the image layer so the container
# can start without needing to create them (hostPath mounts may be read-only
# at the directory level on some container runtimes).
RUN mkdir -p /run/openvswitch /etc/openvswitch

ENTRYPOINT ["/bin/bash"]
